# Database
# ---------
# MySQL/MariaDB: server must be running and reachable at DB_HOST:DB_PORT before the API starts.
# On EC2 with RDS: set DB_HOST to your RDS endpoint (not 127.0.0.1 unless you use a tunnel).
#
# SQLite (no MySQL): omit DB_ENGINE or set it to anything other than "mysql", e.g.:
#   DB_ENGINE=sqlite
DB_ENGINE=mysql
DB_NAME=metafit
DB_USER=metafit_user
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
#
# Error 1045 "Access denied": DB_USER/DB_PASSWORD in .env must match a MySQL user
# created for the same host Django uses (e.g. 'user'@'localhost' when DB_HOST is 127.0.0.1).

# Optional
# ALLOWED_HOSTS=your.domain.com,51.21.196.50
